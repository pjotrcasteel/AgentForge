root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{cs,csx}]
charset = utf-8-bom
end_of_line = crlf
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error
